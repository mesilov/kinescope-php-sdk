# Скопируйте этот файл в .env.local и заполните значения
KINESCOPE_API_KEY=your-api-key-here
TESTS_VIDEO_DOWNLOADER_VIDEO_ID=your-video-id-here
TESTS_VIDEO_DOWNLOADER_FOLDER_ID=your-folder-id-here

# Opt-in флаг для тяжёлых downloader-тестов (реально качают файлы с CDN).
# По умолчанию они скипаются; "make test-integration-download" прокидывает этот флаг автоматически.
TESTS_VIDEO_DOWNLOADER_ENABLED=0
